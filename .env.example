# This project uses direnv + ~/.secrets/ for credentials
# Add these to ~/.secrets/spotify:
#
# export SPOTIFY_CLIENT_ID="your_client_id"
# export SPOTIFY_CLIENT_SECRET="your_client_secret"
# export SPOTIFY_REDIRECT_URI="https://localhost:8080"
#
# Then create .envrc containing:
# source ~/.secrets/spotify
#
# Run: direnv allow .
